pipeline {
    agent any


    environment {
        IMAGE_NAME = "manojkrishnappa/postgress-rag-dev:${GIT_COMMIT}"
        AWS_REGION = "ap-northeast-1"
        CLUSTER_NAME = "itkannadigaru-cluster"
        NAMESPACE = "quantam"
        OWASP_FAIL_CVSS = "7"
    }

    stages {

        stage('git-checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ManojKRISHNAPPA/postgress-rag.git'
            }
        }

        stage('setup-python-env') {
            steps {
                sh '''
                    python3 -m venv .venv

                    . .venv/bin/activate

                    pip install --upgrade pip
                    pip install -r requirements.txt
                    pip install -r requirements-dev.txt
                '''
            }
        }

        stage('unit-tests') {
            steps {
                sh '''
                    . .venv/bin/activate

                    mkdir -p test-results

                    pytest \
                        --junitxml=test-results/junit.xml \
                        --cov=. \
                        --cov-report=xml:coverage.xml \
                        --cov-report=html:coverage-html \
                        --cov-report=term
                '''
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'test-results/junit.xml'
                    )

                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage-html',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                }
            }
        }

        stage('Mutation Testing') {
            steps {
                sh '''
                    . .venv/bin/activate

                    rm -rf mutation-report
                    mkdir -p mutation-report

                    echo "=========================================="
                    echo "Running Mutmut Mutation Testing"
                    echo "=========================================="

                    mutmut run

                    echo "=========================================="
                    echo "Collecting Mutmut Results"
                    echo "=========================================="

                    mutmut results > mutation-report/mutmut-results.txt

                    echo "=========================================="
                    echo "Generating HTML Report"
                    echo "=========================================="

                    python3 <<'PYTHON'
import html
from pathlib import Path
from datetime import datetime

results_file = Path("mutation-report/mutmut-results.txt")
html_file = Path("mutation-report/index.html")

results = results_file.read_text(
    encoding="utf-8",
    errors="replace"
)

safe_results = html.escape(results)

generated_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

report = f"""<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Mutmut Mutation Testing Report</title>

    <style>

        * {{
            box-sizing: border-box;
        }}

        body {{
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            background: #f5f7fa;
            color: #222;
        }}

        .header {{
            background: #1f2937;
            color: white;
            padding: 30px 40px;
        }}

        .header h1 {{
            margin: 0 0 8px 0;
            font-size: 28px;
        }}

        .header p {{
            margin: 0;
            opacity: 0.8;
        }}

        .container {{
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }}

        .card {{
            background: white;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }}

        .card h2 {{
            margin-top: 0;
            margin-bottom: 20px;
            color: #1f2937;
        }}

        .status {{
            display: inline-block;
            padding: 8px 14px;
            border-radius: 5px;
            background: #2563eb;
            color: white;
            font-weight: bold;
        }}

        .info {{
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }}

        .info-box {{
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            padding: 15px;
            border-radius: 6px;
        }}

        .info-box strong {{
            display: block;
            color: #6b7280;
            margin-bottom: 5px;
            font-size: 13px;
        }}

        .info-box span {{
            font-size: 16px;
            font-weight: bold;
        }}

        pre {{
            background: #111827;
            color: #e5e7eb;
            padding: 20px;
            border-radius: 6px;
            overflow-x: auto;
            line-height: 1.5;
            white-space: pre-wrap;
            font-family: monospace;
        }}

        footer {{
            text-align: center;
            color: #6b7280;
            padding: 30px;
            font-size: 13px;
        }}

    </style>

</head>

<body>

    <div class="header">

        <h1>
            Mutmut Mutation Testing Report
        </h1>

        <p>
            Postgres RAG - DevSecOps Pipeline
        </p>

    </div>

    <div class="container">

        <div class="card">

            <h2>
                Mutation Testing Status
            </h2>

            <span class="status">
                Mutmut 3.7.0
            </span>

        </div>

        <div class="card">

            <h2>
                Build Information
            </h2>

            <div class="info">

                <div class="info-box">
                    <strong>Generated</strong>
                    <span>{generated_time}</span>
                </div>

                <div class="info-box">
                    <strong>Mutmut Version</strong>
                    <span>3.7.0</span>
                </div>

                <div class="info-box">
                    <strong>Python Version</strong>
                    <span>3.12</span>
                </div>

                <div class="info-box">
                    <strong>Source</strong>
                    <span>rag_core.py</span>
                </div>

            </div>

        </div>

        <div class="card">

            <h2>
                Mutmut Results
            </h2>

            <pre>{safe_results}</pre>

        </div>

    </div>

    <footer>
        Generated by Jenkins DevSecOps Pipeline
    </footer>

</body>

</html>
"""

html_file.write_text(
    report,
    encoding="utf-8"
)

print(
    f"HTML report generated successfully: {html_file}"
)

PYTHON

                    echo "=========================================="
                    echo "Mutation Report Files"
                    echo "=========================================="

                    ls -lah mutation-report/
                '''
            }

            post {
                always {

                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'mutation-report',
                        reportFiles: 'index.html',
                        reportName: 'Mutation Testing Report',
                        reportTitles: 'Mutmut Mutation Testing'
                    ])

                    archiveArtifacts(
                        artifacts: 'mutation-report/**/*',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {

                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \\
                                -Dsonar.projectKey=postgress-rag \\
                                -Dsonar.projectName="Postgress-RAG" \\
                                -Dsonar.sources=. \\
                                -Dsonar.tests=tests \\
                                -Dsonar.exclusions=".venv/**,tests/**,mutants/**,mutation-report/**,coverage-html/**,__pycache__/**" \\
                                -Dsonar.python.coverage.reportPaths=coverage.xml \\
                                -Dsonar.python.xunit.reportPath=test-results/junit.xml
                        """
                    }
                }
            }
        }

        stage('Quality Gate'){
            steps{
                timeout(time: 1, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }


        stage('owasp-dependency-check'){
            steps{
                withCredentials([string(credentialsId: 'OWASP_NVD_KEY', variable: 'NVD_API_KEY')]) {
                    dependencyCheck additionalArguments: '--scan . --format XML --format HTML --out dependency-check-report --disableYarnAudit --disableNodeAudit --failOnCVSS ' + OWASP_FAIL_CVSS + ' --nvdApiKey ' + NVD_API_KEY, odcInstallation: 'OWASP-Dependency-Check'
                }
                dependencyCheckPublisher pattern: 'dependency-check-report/dependency-check-report.xml'
            }
        }
    }
}