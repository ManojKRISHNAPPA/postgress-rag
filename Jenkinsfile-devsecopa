pipeline {
    agent any

    environment {
        IMAGE_NAME = "manojkrishnappa/postgress-rag-dev:${GIT_COMMIT}"
        AWS_REGION = "ap-northeast-1"
        CLUSTER_NAME = "itkannadigaru-cluster"
        NAMESPACE = "quantam"
    }

    stages {

        stage('git-checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ManojKRISHNAPPA/postgress-rag.git'
            }
        }

        stage('setup-python-env') {
            steps {
                sh '''
                    python3 -m venv .venv

                    . .venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                    pip install -r requirements-dev.txt
                '''
            }
        }

        stage('unit-tests') {
            steps {
                sh '''
                    . .venv/bin/activate

                    mkdir -p test-results

                    pytest \
                        --junitxml=test-results/junit.xml \
                        --cov=. \
                        --cov-report=xml:coverage.xml \
                        --cov-report=html:coverage-html \
                        --cov-report=term
                '''
            }

            post {
                always {
                    junit allowEmptyResults: true,
                        testResults: 'test-results/junit.xml'

                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage-html',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                }
            }
        }

        stage('Mutation Testing') {
            steps {
                sh '''
                    . .venv/bin/activate

                    rm -rf mutation-report
                    mkdir -p mutation-report

                    echo "Running Mutmut..."
                    mutmut run

                    echo "Collecting Mutmut results..."
                    mutmut results > mutation-report/mutmut-results.txt

                    echo "Generating HTML report..."

                    python3 <<'PYTHON'
        import html
        from pathlib import Path
        from datetime import datetime

        results_file = Path("mutation-report/mutmut-results.txt")
        html_file = Path("mutation-report/index.html")

        results = results_file.read_text(
            encoding="utf-8",
            errors="replace"
        )

        safe_results = html.escape(results)

        report = f"""<!DOCTYPE html>
        <html lang="en">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">

            <title>Mutmut Mutation Testing Report</title>

            <style>
                body {{
                    font-family: Arial, Helvetica, sans-serif;
                    margin: 0;
                    background: #f5f7fa;
                    color: #222;
                }}

                .header {{
                    background: #1f2937;
                    color: white;
                    padding: 25px 40px;
                }}

                .header h1 {{
                    margin: 0 0 8px 0;
                }}

                .header p {{
                    margin: 0;
                    opacity: 0.8;
                }}

                .container {{
                    max-width: 1200px;
                    margin: 30px auto;
                    padding: 0 20px;
                }}

                .card {{
                    background: white;
                    border-radius: 8px;
                    padding: 25px;
                    margin-bottom: 25px;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
                }}

                .card h2 {{
                    margin-top: 0;
                    color: #1f2937;
                }}

                pre {{
                    background: #111827;
                    color: #e5e7eb;
                    padding: 20px;
                    border-radius: 6px;
                    overflow-x: auto;
                    line-height: 1.5;
                    white-space: pre-wrap;
                }}

                .status {{
                    display: inline-block;
                    padding: 8px 14px;
                    border-radius: 5px;
                    background: #2563eb;
                    color: white;
                    font-weight: bold;
                }}

                .info {{
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                    gap: 15px;
                }}

                .info-box {{
                    background: #f9fafb;
                    border: 1px solid #e5e7eb;
                    padding: 15px;
                    border-radius: 6px;
                }}

                .info-box strong {{
                    display: block;
                    color: #6b7280;
                    margin-bottom: 5px;
                }}

                footer {{
                    text-align: center;
                    color: #6b7280;
                    padding: 30px;
                }}
            </style>
        </head>

        <body>

        <div class="header">
            <h1>Mutmut Mutation Testing Report</h1>
            <p>Postgres RAG - DevSecOps Pipeline</p>
        </div>

        <div class="container">

            <div class="card">
                <h2>Mutation Testing Status</h2>
                <span class="status">Mutmut 3.7.0</span>
            </div>

            <div class="card">
                <h2>Build Information</h2>

                <div class="info">

                    <div class="info-box">
                        <strong>Generated</strong>
                        {datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
                    </div>

                    <div class="info-box">
                        <strong>Mutmut Version</strong>
                        3.7.0
                    </div>

                    <div class="info-box">
                        <strong>Python</strong>
                        3.12
                    </div>

                    <div class="info-box">
                        <strong>Source</strong>
                        rag_core.py
                    </div>

                </div>
            </div>

            <div class="card">
                <h2>Mutmut Results</h2>
                <pre>{safe_results}</pre>
            </div>

        </div>

        <footer>
            Generated by Jenkins DevSecOps Pipeline
        </footer>

        </body>
        </html>
        """

        html_file.write_text(report, encoding="utf-8")

        print(f"HTML report generated: {html_file}")
        PYTHON

                    echo "Generated files:"
                    ls -lh mutation-report/
                '''
            }

            post {
                always {
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'mutation-report',
                        reportFiles: 'index.html',
                        reportName: 'Mutation Testing Report',
                        reportTitles: 'Mutmut Mutation Testing'
                    ])

                    archiveArtifacts(
                        artifacts: 'mutation-report/**/*',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }
    }
}